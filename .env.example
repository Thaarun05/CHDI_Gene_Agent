# Gene Dossier Platform - environment variable template
# Copy to .env and fill in values. NEVER commit real API keys.

# --- API keys (all optional; missing keys degrade gracefully) ---
# NCBI E-utilities key: raises rate limits for NCBI Gene / PubMed / ClinVar. Optional.
NCBI_API_KEY=
# BioGRID access key: REQUIRED for BioGRID; without it the source is marked requires_key.
BIOGRID_ACCESSKEY=
# OMIM API key: REQUIRED for OMIM; without it the source is marked requires_key.
OMIM_API_KEY=
# SerpAPI key: enables patent search; without it patents are marked manual/requires_key.
SERPAPI_API_KEY=

# --- LLM providers (optional; retrieval + reports run without these) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default model used for synthesis/verification when an LLM key is present.
DEFAULT_LLM_MODEL=

# --- Storage / database ---
# Local SQLite (offline / unit tests / quick smoke runs):
DATABASE_URL=sqlite:///data/gene_dossier.db
# Supabase Postgres (main shared/dev database) — use SQLAlchemy + psycopg form:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres
# Example (do not commit real credentials):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

RAW_DATA_DIR=data/raw
OUTPUT_DIR=data/outputs
